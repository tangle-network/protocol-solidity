    "**/pacote/tar": "7.5.22",
    "**/lerna/tar": "7.5.22",
    "**/@lerna/legacy-package-management/tar": "7.5.22",
    "**/tar": "7.5.22",
    "tmp": "0.2.7",
    "undici": "5.29.0",
    "webpack": "5.106.2",
    "**/ethers/@ethersproject/providers/ws": "8.21.0",
    "**/hardhat-gas-reporter/viem/ws": "8.21.0",
    "hardhat/ws": "7.5.11",
    "**/swarm-js/eth-lib/ws": "5.2.5"
  }
}
